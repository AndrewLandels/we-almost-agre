# Optional later — not required for the default delayed Yahoo feed.
# Keys belong on the server (Vercel env / `api/quote.ts`), not in VITE_* .
# PRICE_FEED_PROVIDER=yahoo
# FINNHUB_API_KEY=
# TWELVEDATA_API_KEY=

# Agreement Gap.
# The live site can run without these: Vercel proxies to the hosted Supabase
# edge function (project we-almost-agree, eu-west-2). Set the secret key if you
# want the Vercel function to use this repo's code directly instead.
# Never put the secret key in a VITE_* variable.
# SUPABASE_URL=https://xcedcymypsrafknfzxxz.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AGREE_EDGE_URL=https://xcedcymypsrafknfzxxz.supabase.co/functions/v1/agree
# AGREE_EDGE_SECRET=
# AGREE_STORE=file
# AGREE_DATA_PATH=.data/agree.json
